# Duplicate this file and rename its copy as .env and update the variables based on your environment
  
# REALTIME or SIMULATION for testing
ENV=SIMULATION
LIDAR=SIMULATION
IMU=SIMULATION
VISUALIZATION=OFF

# true when running in Gazebo simulation, false for real hardware
USE_SIM_TIME=true

# true to run ros2_control with mock_components/GenericSystem
# false to use GazeboSimSystem backend (requires Gazebo)
USE_MOCK_HARDWARE=true


