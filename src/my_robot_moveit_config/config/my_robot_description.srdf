<?xml version="1.0" encoding="UTF-8"?>
<robot name="my_robot_description">
    <!-- GROUPS -->
    <!-- Arm group - for planning arm movements -->
    <group name="arm">
        <!-- Use chain definition for better planning -->
        <chain base_link="base_link" tip_link="tool_link"/>
        <!-- Also include joints for completeness -->
        <joint name="Joint_1"/>
        <joint name="Joint_2"/>
        <joint name="Joint_3"/>
        <joint name="Joint_4"/>
        <joint name="Joint_5"/>
        <joint name="Joint_6"/>
    </group>
    
    <group name="gripper">
        <joint name="Gripper_Idol_Gear_Joint"/>
        <joint name="Gripper_Servo_Gear_Joint"/>
    </group>
   
    <!-- GROUP STATES (keep existing) -->
    <group_state name="home" group="arm">
     <joint name="Joint_1" value="-9.306237189323058e-05"/>
     <joint name="Joint_2" value="0.73"/>
     <joint name="Joint_3" value="0.49999999998185113"/>
     <joint name="Joint_4" value="-0.4999999999946486"/>
     <joint name="Joint_5" value="1.0"/>
     <joint name="Joint_6" value="0.0"/>
    </group_state>
    
    <group_state name="pose_1" group="arm">
        <joint name="Joint_1" value="0.5467"/>
        <joint name="Joint_2" value="-0.1475"/>
        <joint name="Joint_3" value="0.3384"/>
        <joint name="Joint_4" value="-0.0955"/>
        <joint name="Joint_5" value="-0.0781"/>
        <joint name="Joint_6" value="0"/>
    </group_state>
    
    <group_state name="pose_2" group="arm">
        <joint name="Joint_1" value="-1.1021"/>
        <joint name="Joint_2" value="0.6682"/>
        <joint name="Joint_3" value="0"/>
        <joint name="Joint_4" value="0"/>
        <joint name="Joint_5" value="0"/>
        <joint name="Joint_6" value="0"/>
    </group_state>
    
    <group_state name="gripper_half_closed" group="gripper">
        <joint name="Gripper_Idol_Gear_Joint" value="-0.8031"/>
        <joint name="Gripper_Servo_Gear_Joint" value="0.8013"/>
    </group_state>
    
    <group_state name="gripper_open" group="gripper">
        <joint name="Gripper_Idol_Gear_Joint" value="-0.05"/>
        <joint name="Gripper_Servo_Gear_Joint" value="0.05"/>
    </group_state>
    
    <group_state name="gripper_closed" group="gripper">
        <joint name="Gripper_Idol_Gear_Joint" value="-1.40"/>
        <joint name="Gripper_Servo_Gear_Joint" value="1.45"/>
    </group_state>
    
    <!-- END EFFECTOR -->
    <end_effector name="gripper_ee" parent_link="tool_link" group="gripper"/>
    
    <!-- VIRTUAL JOINT -->
    <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="base_link"/>
    
    <!-- PASSIVE JOINTS -->
    <passive_joint name="Tip_Gripper_Servo_Joint"/>
    <passive_joint name="Pivot_Arm_Gripper_Idol_Joint"/>
    <passive_joint name="Pivot_Arm_Gripper_Servo_Joint"/>
    <passive_joint name="Tip_Gripper_Idol_Joint"/>

   

    <!-- DISABLE COLLISIONS (keep your existing ones) -->
    <disable_collisions link1="Gripper_Idol_Gear" link2="Gripper_Servo_Gear" reason="Always"/>
    <disable_collisions link1="Gripper_Idol_Gear" link2="Pivot_Arm_Gripper_Idol" reason="Always"/>
    <disable_collisions link1="Gripper_Idol_Gear" link2="Pivot_Arm_Gripper_Servo" reason="Never"/>
    <disable_collisions link1="Gripper_Idol_Gear" link2="Tip_Gripper_Idol" reason="Adjacent"/>
    <disable_collisions link1="Gripper_Idol_Gear" link2="Tip_Gripper_Servo" reason="Never"/>
    <disable_collisions link1="Gripper_Idol_Gear" link2="arm_link" reason="Never"/>
    <disable_collisions link1="Gripper_Idol_Gear" link2="elbow_link" reason="Never"/>
    <disable_collisions link1="Gripper_Idol_Gear" link2="forearm_link" reason="Never"/>
    <disable_collisions link1="Gripper_Idol_Gear" link2="tool_link" reason="Default"/>
    <disable_collisions link1="Gripper_Idol_Gear" link2="hand_link" reason="Default"/>
    <disable_collisions link1="Gripper_Idol_Gear" link2="wrist_link" reason="Adjacent"/>
    <disable_collisions link1="Gripper_Servo_Gear" link2="Pivot_Arm_Gripper_Idol" reason="Never"/>
    <disable_collisions link1="Gripper_Servo_Gear" link2="Tip_Gripper_Idol" reason="Never"/>
    <disable_collisions link1="Gripper_Servo_Gear" link2="Tip_Gripper_Servo" reason="Adjacent"/>
