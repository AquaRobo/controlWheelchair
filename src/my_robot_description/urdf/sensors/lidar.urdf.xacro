        <mesh filename="package://my_robot_description/meshes/wheel_robot_meshes/lidar_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="lidar_joint" type="fixed">
    <origin xyz="-0.23863 -0.39702 0.43" rpy="0 0 -1.6081" />
    <parent link="base_link" />
    <child link="lidar_link" />
