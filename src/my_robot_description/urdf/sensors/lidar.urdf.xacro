      <origin xyz="-0.0050072 -0.00071908 0.026735" rpy="0 0 0" />
      <mass value="0.073084" />
      <inertia ixx="1.9594E-05" ixy="-2.7283E-07" ixz="-4.2841E-07" iyy="2.4111E-05" iyz="-6.5248E-09" izz="4.1418E-05" />
