<robot name="wheel_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:arg name="use_lidar_sim" default="true"/>
    <xacro:arg name="use_imu_sim" default="true"/>
    <xacro:arg name="use_camera_sim" default="true"/>
    <xacro:arg name="use_mock_hardware" default="false"/>
    <!-- Robot components -->
    <xacro:include filename="wheelchair/wheelchair.urdf.xacro" />
    <xacro:include filename="arm/arm.urdf.xacro" />
    <xacro:include filename="sensors/imu.urdf.xacro" />
    <xacro:include filename="sensors/stereo_camera.urdf.xacro" />
    <xacro:include filename="sensors/lidar.urdf.xacro" />

    <!-- Robot Gazebo Plugins -->
    <xacro:include filename="wheelchair/wheelchair_gazebo.urdf.xacro" />

    <!-- Robot Controllers -->
     <xacro:include filename="wheel_robot.ros2_control.xacro" />
</robot>