<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <ros2_control name="WheelRobotHardwareInterface" type="system">
        <hardware>
            <xacro:if value="$(arg use_mock_hardware)">
                <plugin>mock_components/GenericSystem</plugin>
                <param name="calculate_dynamics">true</param>
            </xacro:if>
            <xacro:unless value="$(arg use_mock_hardware)">
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                <param name="calculate_dynamics">true</param>
            </xacro:unless>
        </hardware>
        <xacro:include filename="$(find my_robot_description)/urdf/wheelchair/wheelchair.ros2_control.xacro" />
        <xacro:include filename="$(find my_robot_description)/urdf/arm/arm.ros2_control.xacro" />
    </ros2_control>   
</robot>