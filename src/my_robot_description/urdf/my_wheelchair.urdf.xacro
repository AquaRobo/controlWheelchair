<?xml version="1.0"?>
<robot name="Wheelchair_urdf" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:arg name="use_lidar_sim" default="true"/>
    <xacro:arg name="use_imu_sim" default="true"/>
    <xacro:arg name="use_mock_hardware" default="false"/>
    <xacro:include filename="common_properties.xacro" />
    <xacro:include filename="wheelchair_base.xacro" />
    <xacro:include filename="wheelchair_base.ros2_control.xacro" />

</robot>